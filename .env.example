# Copy to .env.local and fill in. Never commit .env.local.
XAI_API_KEY=
CIRCLE_API_KEY=TEST_API_KEY:...
CIRCLE_ENTITY_SECRET=
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
QUICKNODE_API_KEY=
QUICKNODE_STREAM_SECURITY_TOKEN=
COSIGN_SECRET=
CRON_SECRET=
# optional: your own wallet address, added as All access to the demo workspace by scripts/seed-demo.ts
COSIGN_OWNER_ADDRESS=
# Optional: the one header Grok Bot reads the webhook key from (default: Authorization and X-Webhook-Key)
GROKBOT_WEBHOOK_HEADER=

# ElevenLabs voice (pnpm voice setup). The key needs ElevenAgents and webhook access.
ELEVENLABS_API_KEY=
# optional: the voice agent's LLM (default gemini-2.5-flash) and voice id
ELEVENLABS_LLM=
ELEVENLABS_VOICE_ID=
